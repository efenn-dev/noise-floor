extends "res://test/base_test.gd"
## S3: the hotbar (ten slots under 1-9 and 0); V19: two of them, hands and build: defaults, what may go on a key, moving a thing between keys,
## saving and loading (and the version-12 fixture from before it), and doors that swing away from whoever
## opens them (BuildGrid.swing_away_from / door_pose).

const N := BuildGrid.Side.NORTH


func test_defaults_and_slots() -> void:
	var sim := SimWorld.new()
	var h := sim.hotbar
	eq(h.slots.size(), Hotbar.SLOTS, "ten hands slots")
	eq(h.build_slots.size(), Hotbar.SLOTS, "ten build slots")
	eq(h.entry(0), "slot:weapon", "V19: on foot, 1 draws your melee weapon")
	eq(h.entry(1), "slot:primary", "2 the rifle")
	eq(h.entry(2), "slot:sidearm", "3 the pistol")
	eq(h.entry(3), "item:bandage", "4 a bandage")
	eq(h.entry(0, Hotbar.BUILD_BAR), "build:foundation", "in build mode 1 is the foundation")
	eq(h.kind(0, Hotbar.BUILD_BAR), "build", "a piece")
	eq(h.id(0, Hotbar.BUILD_BAR), "foundation", "its id")
	eq(h.kind(0), "slot", "a weapon slot")
	eq(h.id(0), "weapon", "its id")
	eq(h.kind(3), "item", "an item")
	eq(h.id(3), "bandage", "its id")
	eq(h.label(0, Hotbar.BUILD_BAR), "Foundation", "named from the data")
	eq(h.label(3), "Bandage", "items too")
	eq(h.label(1), "Primary", "weapon slots by their slot name")
	check(not h.slots.any(func(e: String) -> bool: return e.begins_with(Hotbar.BUILD)), "no building piece on the hands bar")
	check(not h.build_slots.any(func(e: String) -> bool: return e != "" and not e.begins_with(Hotbar.BUILD)), "only pieces on the build bar")
	eq(Hotbar.key_name(0), "1", "slot 0 is key 1")
	eq(Hotbar.key_name(9), "0", "slot 9 is key 0")
	eq(h.entry(10), "", "no eleventh slot")
	eq(h.find("build:wall"), 1, "find looks on the bar the entry belongs on")
	eq(h.find("slot:sidearm"), 2, "weapon slots too")
	eq(h.find(""), -1, "an empty entry is nowhere")


func test_assigning_and_what_is_allowed() -> void:
	var sim := SimWorld.new()
	var h := sim.hotbar
	eq(h.assign(3, "build:wall"), "", "a piece goes on key 4")
	eq(h.entry(3, Hotbar.BUILD_BAR), "build:wall", "of the build bar")
	eq(h.entry(1, Hotbar.BUILD_BAR), "", "and gone from key 2 there: a thing is on one key only")
	eq(h.entry(3), "item:bandage", "the hands bar didn't change")
	eq(h.assign(5, "item:canned_food"), "", "food goes on a key")
	eq(h.entry(5), "item:canned_food", "of the hands bar")
	eq(h.entry(5, Hotbar.BUILD_BAR), "build:belt", "not the build bar")
	eq(h.assign(6, "slot:primary"), "", "a weapon slot can move")
	eq(h.entry(6), "slot:primary", "to key 7")
	eq(h.entry(1), "", "leaving key 2")
	eq(h.assign(2, "item:plank"), "Only food, drink and bandages go on the hotbar", "planks don't")
	eq(h.assign(2, "build:town_wall"), "Only found in town", "town pieces don't")
	eq(h.assign(2, "build:no_such_piece"), "Unknown piece", "unknown pieces don't")
	eq(h.assign(2, "item:no_such_item"), "Unknown item", "unknown items don't")
	eq(h.assign(2, "slot:head"), "Not a weapon slot", "only weapon slots")
	eq(h.assign(2, "garbage"), "Not a piece, an item or a weapon slot", "nor anything else")
	eq(h.entry(2), "slot:sidearm", "the refusals changed nothing")
	eq(h.assign(10, "build:wall"), "No such slot", "keys are 1-9 and 0")
	eq(h.assign(-1, "build:wall"), "No such slot", "no negative slots")
	h.clear(3, Hotbar.BUILD_BAR)
	eq(h.entry(3, Hotbar.BUILD_BAR), "", "cleared on the build bar")
	h.clear(5)
	eq(h.entry(5), "", "and on the hands bar")
	check(h.usable("clean_water") and h.usable("bandage") and not h.usable("nails"), "usable = food, drink, bandage")
	eq(h.validate(""), "", "an empty entry is fine")


func test_hands_keys_draw_weapons() -> void:
	var sim := SimWorld.new()
	var rifle := sim.gear.make("hunting_rifle", "civilian", "white")
	sim.gear.pieces.append(rifle)
	sim.gear.equip(int(rifle["uid"]))
	eq(sim.guns.hands, "melee", "you start with the pipe in hand")
	eq(sim.draw_weapon("primary"), "%s in hand" % sim.gear.gun_name(), "key 2 draws the rifle")
	eq(sim.guns.hands, "primary", "the rifle is in your hands")
	check(sim.guns.raising > 0.0, "raised like a Q swap")
	eq(sim.draw_weapon("sidearm"), "No pistol equipped (Tab)", "key 3 with no pistol says so")
	eq(sim.guns.hands, "primary", "and keeps the rifle")
	eq(sim.draw_weapon("weapon"), "%s in hand" % sim.gear.weapon_name(), "key 1 goes back to the melee weapon")
	eq(sim.guns.hands, "melee", "the pipe again")


func test_save_and_load() -> void:
	var sim := SimWorld.new()
	sim.hotbar.assign(4, "item:chips")
	sim.hotbar.assign(4, "build:nail_turret")
	sim.hotbar.clear(7, Hotbar.BUILD_BAR)
	var saved: Dictionary = sim.hotbar.to_dict()
	var again := Hotbar.new(sim.data)
	again.load_saved(saved)
	eq(again.to_dict(), saved, "round trip")
	again.load_saved([])
	eq(again.to_dict(), Hotbar.new(sim.data).to_dict(), "nothing saved means the defaults (a save from before the hotbar)")
	again.load_saved({"hands": ["build:wall", "item:no_such_item", "item:chips"], "build": ["item:chips", "build:wall"]})
	eq(again.entry(0), "", "a piece saved on the hands bar is dropped")
	eq(again.entry(1), "", "an entry the data doesn't know is dropped")
	eq(again.entry(2), "item:chips", "a good entry stays")
	eq(again.entry(0, Hotbar.BUILD_BAR), "", "an item saved on the build bar is dropped")
	eq(again.entry(1, Hotbar.BUILD_BAR), "build:wall", "a piece stays")
	# Through SaveGame.
	var d := SaveGame.to_dict(sim)
	eq(d["hotbar"], saved, "saved")
	var b := SimWorld.new()
	eq(SaveGame.apply(b, d), "", "loads")
	eq(b.hotbar.to_dict(), saved, "and both bars came back")
	d.erase("hotbar")
	var c := SimWorld.new()
	eq(SaveGame.apply(c, d), "", "a save without one loads")
	eq(c.hotbar.to_dict(), Hotbar.new(sim.data).to_dict(), "with the defaults")


## test/fixtures/save_v12.json was written by the M17a-era code before the hotbar and door swings (the
## seed-1 town and park, a foundation with a door and a crate on it, day 5 09:00).
func test_version_12_save_still_loads() -> void:
	var d := SaveGame.read("res://test/fixtures/save_v12.json")
	eq(int(d.get("version", 0)), 12, "the fixture is a version-12 save")
	check(not d.has("hotbar"), "it predates the hotbar")
	check(not d["pieces"][0].has("swing"), "and door swings")
	var sim := SimWorld.new(8.0, null, int(d["seed"]))
	eq(SaveGame.apply(sim, d), "", "loads cleanly")
	eq(sim.hotbar.to_dict(), Hotbar.new(sim.data).to_dict(), "with the default hotbars")
	var door := sim.build.key_for("door", Vector2i(0, 0), BuildGrid.Side.SOUTH)
	check(sim.build.pieces.has(door), "the door you built is there")
	check(not sim.build.pieces[door].get("open", false), "shut, as saved")
	eq(sim.build.door_pose(door).origin, sim.build.piece_center(door), "a shut door stands on its edge")
	eq(sim.clock.day, 5, "day 5")
	var again := SaveGame.to_dict(sim)
	eq(int(again["version"]), SaveGame.VERSION, "saved again as the current version")
	check(again.has("hotbar"), "with a hotbar")


## test/fixtures/save_v17.json was written by the V18 code (one shared bar): pieces and food mixed on it.
func test_version_17_single_bar_splits_in_two() -> void:
	var d := SaveGame.read("res://test/fixtures/save_v17.json")
	eq(int(d.get("version", 0)), 17, "the fixture is a version-17 save")
	check(d["hotbar"] is Array, "with the old single bar")
	var sim := SimWorld.new(8.0, null, int(d["seed"]))
	eq(SaveGame.apply(sim, d), "", "loads cleanly")
	var h := sim.hotbar
	eq(h.entry(0, Hotbar.BUILD_BAR), "build:wall", "pieces keep their keys on the build bar (1 wall)")
	eq(h.entry(2, Hotbar.BUILD_BAR), "build:foundation", "3 foundation")
	eq(h.entry(5, Hotbar.BUILD_BAR), "build:door", "6 door")
	eq(h.entry(7, Hotbar.BUILD_BAR), "build:storage", "8 storage")
	eq(h.entry(1, Hotbar.BUILD_BAR), "", "the food's old key is empty there")
	eq(h.entry(0), "slot:weapon", "the weapons take 1-3 of the hands bar")
	eq(h.entry(1), "slot:primary", "2")
	eq(h.entry(2), "slot:sidearm", "3")
	eq(h.entry(3), "item:bandage", "the bandage")
	eq(h.entry(8), "item:soda", "soda keeps its key (9)")
	check(h.find("item:canned_food") >= 3, "canned food moved past the weapons (key %s)" % Hotbar.key_name(h.find("item:canned_food")))
	check(not h.slots.any(func(e: String) -> bool: return e.begins_with(Hotbar.BUILD)), "no piece on the hands bar")
	var again := SaveGame.to_dict(sim)
	eq(int(again["version"]), SaveGame.VERSION, "saved again as the current version")
	check(again["hotbar"] is Dictionary, "as two bars")


func test_doors_swing_away_from_whoever_opens_them() -> void:
	var sim := SimWorld.new()
	sim.give_debug_kit()
	eq(sim.build.place("foundation", Vector2i(0, 0), N, sim.inventory), "", "a floor")
	eq(sim.build.place("door", Vector2i(0, 0), N, sim.inventory), "", "a door on its north edge")
	var key := sim.build.key_for("door", Vector2i(0, 0), N)
	var center := sim.build.piece_center(key)
	near(center.x, 1.0, "the door's middle, x")
	near(center.z, 0.0, "the door's middle, z (the edge between z<0 and z>0)")
	var closed := sim.build.door_pose(key)
	eq(closed.origin, center, "shut: on its edge")
	near(closed.basis.x.x, 1.0, "shut: it runs east-west")
	eq(sim.build.swing_away_from(key, Vector3(1, 0, 1.5)), 1, "someone south of it: it swings north")
	eq(sim.build.swing_away_from(key, Vector3(1, 0, -1.5)), -1, "someone north of it: it swings south")
	# Opened from the south (the cell it's on): the panel ends up along the north side, hinged at its west end.
	check(sim.build.toggle_door(key, Vector3(1.0, 0.0, 1.5)), "opens")
	eq(int(sim.build.pieces[key]["swing"]), 1, "swinging north")
	var open := sim.build.door_pose(key)
	near(open.origin.x, 0.0, "hinged at its west end (x)")
	near(open.origin.z, -1.0, "the panel's middle is 1 m north of the edge")
	near(open.basis.x.z, -1.0, "the panel runs north-south")
	near(open.origin.y, center.y, "same height")
	check(not sim.build.toggle_door(key, Vector3(1.0, 0.0, -1.5)), "closes (from whichever side)")
	eq(sim.build.door_pose(key).origin, center, "shut again, back on its edge")
	eq(int(sim.build.pieces[key]["swing"]), 1, "closing keeps the last swing")
	check(sim.build.toggle_door(key, Vector3(1.0, 0.0, -1.5)), "opened from the north")
	eq(int(sim.build.pieces[key]["swing"]), -1, "it swings south, away again")
	near(sim.build.door_pose(key).origin.z, 1.0, "the panel is now on the south side")
	sim.build.toggle_door(key)
	check(sim.build.toggle_door(key), "opened with no one given (tests, the soak)")
	eq(int(sim.build.pieces[key]["swing"]), -1, "keeps the swing it had")
	# Through the sim, and the swing survives a save.
	sim.build.toggle_door(key)
	eq(sim.toggle_door(key, Vector3(1.0, 0.0, 1.5)), "Door opened", "SimWorld.toggle_door takes the opener's place")
	eq(int(sim.build.pieces[key]["swing"]), 1, "and swings away from it")
	var b := SimWorld.new()
	eq(SaveGame.apply(b, SaveGame.to_dict(sim)), "", "saved and loaded")
	check(b.build.pieces[key]["open"], "still open")
	eq(int(b.build.pieces[key]["swing"]), 1, "swinging the same way")
	eq(b.build.door_pose(key).origin, sim.build.door_pose(key).origin, "same pose")
